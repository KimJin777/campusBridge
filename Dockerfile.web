# 학생 채팅·관리자 API 웹 이미지(상세설계 07 §6).
# 웹 의존성 + pyhwp(교내 문서 자동 채움의 HWP 본문 — 교수님 2026-10-01). LibreOffice 없음, uv 잠금 파일 기반, 비루트 사용자.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PORT=8080

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra ingest --no-install-project

COPY backend ./backend
COPY frontend ./frontend
COPY config ./config
# 부서 디렉터리·장소 seed(검수본 CSV) — raw·interim·processed·staging은 .dockerignore로 제외
COPY data ./data

RUN useradd --create-home --uid 10001 app && chown -R app /app
USER app

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8080
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
